---
// Tüm sayfaların ortak <head> bölümü: başlık, açıklama, paylaşım görseli, canonical, hreflang.
import '../styles/global.css';
import site from '../data/site.json';

export interface Props {
  lang: 'tr' | 'en';
  title: string;
  description: string;
  /** Bu sayfanın her iki dildeki adresi, ör. { tr: '/kvkk/', en: '/en/privacy/' } */
  alternates?: { tr: string; en: string };
  /** Paylaşım görseli (tam veya kök göreli adres) */
  image?: string;
  noindex?: boolean;
}

const { lang, title, description, alternates, image = '/og-default.jpg', noindex: pageNoindex = false } = Astro.props;
// Alan adı girilene ve searchEngines açılana kadar hiçbir sayfa arama motorlarına açılmaz
const noindex = pageNoindex || !site.domain || !site.searchEngines;
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (p: string) => new URL(p, Astro.site).href;
const fullTitle = title.startsWith(site.brand) ? title : `${title} · ${site.brand}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!pageNoindex && <link rel="canonical" href={canonical.href} />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="tr" href={abs(alternates.tr)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.tr)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={abs(image)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1E3C54" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
